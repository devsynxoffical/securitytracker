{
  "name": "company-os",
  "version": "1.0.0",
  "private": true,
  "description": "Company OS - Employee Management + Security + CRM Platform",
  "main": "server.js",
  "scripts": {
    "build": "turbo run build && node scripts/postbuild.js",
    "postbuild": "node scripts/postbuild.js",
    "start": "node server.js",
    "dev": "turbo run dev",
    "dist:desktop": "pnpm --filter @company-os/desktop run dist",
    "dist:mac": "pnpm --filter @company-os/desktop run dist:mac",
    "dist:win": "pnpm --filter @company-os/desktop run dist:win",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@9.15.0"
}
