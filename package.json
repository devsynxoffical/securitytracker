{
  "name": "company-os",
  "version": "1.0.0",
  "private": true,
  "description": "Company OS - Employee Management + Security + CRM Platform",
  "scripts": {
    "build": "npm run build --prefix packages/contracts && npm run build --prefix apps/admin",
    "dev": "turbo run dev",
    "dist:desktop": "pnpm --filter @company-os/desktop run dist",
    "dist:mac": "pnpm --filter @company-os/desktop run dist:mac",
    "dist:win": "pnpm --filter @company-os/desktop run dist:win",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "build:web": "npm run build --prefix packages/contracts && npm run build --prefix apps/admin",
    "build:all": "turbo run build"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "undici@<7.30.1": "7.30.1",
      "body-parser@<2.4.0": "2.4.0",
      "multer@<2.5.0": "2.5.0",
      "qs@<6.16.1": "6.17.1",
      "tar@<7.5.21": "7.5.22",
      "tinypool@<2.1.2": "2.2.0",
      "vite@>=6 <6.4.5": "6.4.5",
      "postcss@<8.5.12": "8.5.32",
      "postcss-selector-parser@<6.1.5": "6.1.5",
      "ip-address@<10.7.4": "10.7.5",
      "js-yaml@>=5 <5.4.1": "5.5.0",
      "minimatch@>=10 <11.0.1": "11.0.4",
      "glob@>=10 <14.0.2": "14.0.3",
      "fast-uri@<3.1.9": "3.1.9",
      "deepmerge-ts@<8.0.0": "8.0.2",
      "builder-util-runtime@<9.7.0": "9.7.1",
      "electron@<44.9.1": "44.10.1",
      "electron-builder-squirrel-windows": "26.18.0",
      "app-builder-lib@<26.15.0": "26.18.0"
    },
    "overrides_reason": "Security patches for transitive dependencies flagged by the host scanner (2026-11-03). Remove an entry once its parent ships the fix."
  }
}
