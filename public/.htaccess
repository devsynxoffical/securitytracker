# WorkPulse Company OS - Hostinger Apache & LiteSpeed Configuration
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve root index.html immediately
  RewriteRule ^$ index.html [L]

  # If direct file exists on disk, serve it
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Route /admin to admin.html
  RewriteRule ^admin/?$ admin.html [L]

  # Route clean URLs to .html if exists
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)/?$ /$1.html [L]

  # Route clean URLs from public/
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ /public/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/public/$1.html -f
  RewriteRule ^(.*)/?$ /public/$1.html [L]

  # Fallback for client-side routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.html [L]
</IfModule>

# MIME types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>
