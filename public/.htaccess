# WorkPulse Company OS - Hostinger Apache & LiteSpeed Configuration
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve root index.html immediately
  RewriteRule ^$ index.html [L]

  # Direct redirect for Mac & Windows installers to GitHub Release CDN
  RewriteRule ^downloads/WorkPulse-Mac-Universal\.dmg$ https://github.com/devsynxoffical/securitytracker/releases/download/v1.0.0/WorkPulse-Mac-Universal.dmg [R=302,L]
  RewriteRule ^downloads/WorkPulse-Mac-Installer\.zip$ https://github.com/devsynxoffical/securitytracker/releases/download/v1.0.0/WorkPulse-Mac-Universal.dmg [R=302,L]
  RewriteRule ^downloads/WorkPulse-Setup-x64\.exe$ https://github.com/devsynxoffical/securitytracker/releases/download/v1.0.0/WorkPulse-Windows-x64.zip [R=302,L]
  RewriteRule ^downloads/WorkPulse-Windows-x64\.zip$ https://github.com/devsynxoffical/securitytracker/releases/download/v1.0.0/WorkPulse-Windows-x64.zip [R=302,L]

  # If direct file exists on disk, serve it
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Direct downloads folder mapping
  RewriteCond %{DOCUMENT_ROOT}/downloads/$1 -f
  RewriteRule ^downloads/(.*)$ /downloads/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/public/downloads/$1 -f
  RewriteRule ^downloads/(.*)$ /public/downloads/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/apps/admin/out/downloads/$1 -f
  RewriteRule ^downloads/(.*)$ /apps/admin/out/downloads/$1 [L]

  # Route /admin to admin.html
  RewriteRule ^admin/?$ admin.html [L]

  # Route clean URLs to .html if exists
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)/?$ /$1.html [L]

  # Route clean URLs from public/
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ /public/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/public/$1.html -f
  RewriteRule ^(.*)/?$ /public/$1.html [L]

  # Fallback for client-side routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.html [L]
</IfModule>

# MIME types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/octet-stream .dmg .exe .pkg
  AddType application/x-apple-diskimage .dmg
  AddType application/zip .zip
</IfModule>

# Cache-Control Headers to prevent stale cached admin views
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
