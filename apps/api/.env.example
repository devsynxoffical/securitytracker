# Copy to .env for local development. Never commit real values (02-architecture section 5).
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/company_os
REDIS_URL=redis://localhost:6379
PORT=4000
# 32+ chars; used to sign access, refresh and 2FA temp tokens
JWT_SECRET=change-me-to-a-long-random-string
# 64 hex chars (32 bytes); AES-256-GCM key for TOTP secrets and mailbox tokens
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Base URL of the admin panel, used in password reset links
ADMIN_ORIGIN=http://localhost:3000
# Transactional mail (password resets). Leave SMTP_HOST empty to disable; non-production responses then carry devResetUrl.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (465); false uses STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Company OS <no-reply@example.com>"
